// Futures Journal DB 스키마

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String
  name          String
  credits       Int       @default(0)
  createdAt     DateTime  @default(now())
  apiKeys       ApiKey[]
  memos         Memo[]
  purchases     Purchase[]
  creditLogs    CreditLog[]
  aiReports     AIReport[]
  rules         TradingRule[]
  violations    RuleViolation[]
  milestones    Milestone[]
  chatMessages  ChatMessage[]
  subscription  Subscription?
  sessions      Session[]
  accounts      Account[]
  diaries       TradingDiary[]
  backtestSessions BacktestSession[]
  notificationSetting NotificationSetting?
}

// NextAuth Prisma Adapter 필수 모델
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id              String   @id @default(cuid())
  userId          String
  exchange        String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedKey    String
  encryptedSecret String
  encryptedPass   String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, exchange])
}

model Purchase {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId  String
  credits    Int
  amountKrw  Int
  tossKey    String   @unique
  orderId    String   @unique
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model CreditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  createdAt DateTime @default(now())
}

model Memo {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  positionId  String
  reason      String   @default("")
  exitReason  String   @default("")
  psych       String   @default("")
  external    String   @default("")
  text        String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, positionId])
}

model TradingRule {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  config     Json
  enabled    Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  violations RuleViolation[]

  @@index([userId, enabled])
}

model RuleViolation {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId     String
  rule       TradingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  positionId String
  ruleType   String
  ruleConfig Json
  detectedAt DateTime    @default(now())
  pnlImpact  Float?

  @@unique([ruleId, positionId])
  @@index([userId, detectedAt])
  @@index([userId, ruleType])
}

model Subscription {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String    @default("free")
  status      String    @default("active")
  startedAt   DateTime  @default(now())
  expiresAt   DateTime?
  tossSubKey  String?
  cancelledAt DateTime?
}

model ChatMessage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  content        String
  conversationId String   @default("default")
  createdAt      DateTime @default(now())

  @@index([userId, conversationId, createdAt])
}

model Milestone {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  metadata    Json?
  achievedAt  DateTime @default(now())

  @@unique([userId, type])
  @@index([userId, achievedAt])
}

model AIReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  periodStart DateTime
  periodEnd   DateTime
  content     Json
  createdAt   DateTime @default(now())

  @@index([userId, type, createdAt])
}

model TradingDiary {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  mood      String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model BacktestSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  symbol      String
  startTime   BigInt
  endTime     BigInt
  initialSeed Float    @default(1000)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  completedAt DateTime?

  trades      BacktestTrade[]

  @@index([userId, createdAt])
}

model BacktestTrade {
  id          String          @id @default(cuid())
  sessionId   String
  session     BacktestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  side        String
  entryPrice  Float
  exitPrice   Float?
  size        Float
  leverage    Float           @default(1)
  entryTime   BigInt
  exitTime    BigInt?
  pnl         Float?
  status      String          @default("open")
  stopLoss    Float?
  takeProfit  Float?
  closeReason String?

  @@index([sessionId, entryTime])
}

model NotificationSetting {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramChatId  String?
  telegramLinked  Boolean   @default(false)
  linkCode        String?
  linkCodeExpiresAt DateTime?
  emailEnabled    Boolean   @default(true)
  ruleViolation   Boolean   @default(true)
  largeLoss       Boolean   @default(true)
  liquidationRisk Boolean   @default(true)
  memoReminder    Boolean   @default(false)
  weeklyReport    Boolean   @default(true)
  milestoneAlert  Boolean   @default(true)
  largeLossLastSentAt   DateTime?
  liquidationLastSentAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
